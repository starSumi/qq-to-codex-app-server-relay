# Optional pair: when both are empty, the first start uses QQ QR binding.
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_CREDENTIALS_FILE=./state/qqbot-credentials.json
# dangerous is the sender-policy default; safe requires explicit QQ openids.
RELAY_AUTH_MODE=dangerous
QQBOT_ALLOW_FROM=
QQBOT_READY_TIMEOUT_MS=30000
# QQ SDK request bodies and gateway payloads are suppressed at the default level.
QQBOT_LOG_LEVEL=info
CODEX_HOME=
CODEX_WORKSPACE=./workspace
CODEX_BIN=codex
CODEX_MODEL=
CODEX_APPROVAL_POLICY=never
# Full local command access is enabled by default. This bypasses the Windows
# sandbox runner; set read-only or workspace-write for a constrained profile.
CODEX_SANDBOX=danger-full-access
# Network access is enabled by default for the open profile; set false for lock-down.
CODEX_NETWORK_ACCESS=true
# External Codex integrations are enabled by default. Set false for lock-down.
CODEX_ALLOW_EXTERNAL_TOOLS=true
CODEX_TURN_TIMEOUT_MS=600000
RELAY_CORE_BIN=./target/release/relay-core
RELAY_DB=./state/relay.sqlite3
RELAY_MAX_INPUT_BYTES=16384
RELAY_MAX_OUTPUT_BYTES=32768
RELAY_MAX_CONCURRENT_TURNS=2
RELAY_MAX_QUEUE=64
RELAY_RATE_LIMIT_PER_MINUTE=6
RELAY_RETENTION_DAYS=30
RELAY_LOG=info
