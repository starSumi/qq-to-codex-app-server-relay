{
  "name": "@qq-codex/qq-adapter",
  "version": "0.2.0",
  "private": true,
  "description": "Thin Tencent QQ SDK adapter for the Rust relay core",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:contract": "node scripts/generate-contract.mjs --write",
    "generate:contract:check": "node scripts/generate-contract.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
